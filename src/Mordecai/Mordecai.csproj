<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mordecai</RootNamespace>
    <PackageId>Mordecai</PackageId>
    <Description>High-performance in-process mediator for .NET.</Description>
    <PackageTags>mediator;cqrs;messaging;mediatr-alternative;in-process;pipeline</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Ships the repo-root README inside the package so the nuget.org gallery page renders it. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!--
    The generator ships inside this package so a consumer gets compile-time dispatch
    from a single PackageReference. ReferenceOutputAssembly=false keeps the analyzer
    off the consumer's reference graph.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Mordecai.SourceGenerator\Mordecai.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mordecai.Tests" />
    <InternalsVisibleTo Include="Mordecai.Benchmarks" />
  </ItemGroup>

</Project>
