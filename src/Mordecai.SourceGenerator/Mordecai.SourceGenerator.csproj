<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roslyn loads analyzers into the compiler process, which still runs on
    netstandard2.0. This target framework is fixed by that constraint and is
    deliberately not net10.0 like the rest of the solution.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Mordecai.SourceGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- netstandard2.0 lacks nullable attributes the analyzers expect; not worth polyfilling. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mordecai.SourceGenerator.Tests" />
  </ItemGroup>

</Project>
